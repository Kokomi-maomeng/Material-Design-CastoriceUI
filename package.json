{
  "name": "material-design-castorice-ui",
  "version": "5.9.0",
  "private": false,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Edge >= 111",
      "Firefox >= 113",
      "Safari >= 16.4",
      "iOS >= 16.4"
    ]
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build",
    "release:package": "node scripts/package-release.mjs",
    "preview": "vite preview",
    "test:runtime": "vitest run",
    "test": "npm run test:contracts && npm run test:runtime && npm run test:workflow && npm run test:backend",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:backend": "node scripts/python-run.mjs -m compileall -q server && node scripts/python-run.mjs -m unittest discover -s server/tests -p test_*.py -v",
    "test:workflow": "node scripts/python-run.mjs -m unittest discover -s scripts/tests -p test_*.py -v",
    "scan:sensitive": "node scripts/sensitive-scan.mjs",
    "privacy:install": "node scripts/install-privacy-hooks.mjs",
    "privacy:identity": "node scripts/privacy-guard.mjs identity",
    "privacy:archive": "node scripts/privacy-guard.mjs archive",
    "test:privacy": "node --test tests/privacy-guard.test.mjs",
    "lint": "eslint . --ignore-pattern dist",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:docs && npm run lint && npm run typecheck && npm test && npm run scan:sensitive && npm run build && npm run audit:production && npm run audit:all",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "check:docs": "node scripts/check-release-docs.mjs",
    "audit:all": "npm audit --audit-level=low",
    "preinstall": "node scripts/check-runtime.mjs",
    "precheck": "node scripts/check-runtime.mjs",
    "predev": "node scripts/check-runtime.mjs",
    "prebuild": "node scripts/check-runtime.mjs",
    "doctor": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@material-symbols/font-400": "^0.48.1",
    "clsx": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "type": "module",
  "license": "MIT"
}
